{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://nanobotco.github.io/hand-poke/schema/node.schema.json",
 "title": "Hand-poke node",
 "description": "One record: a tattooing tradition, a way of marking skin by hand, an instrument, a pigment, a design, a rite around the work, a person, a place, a word, an episode, a piece of physical evidence, a depiction, an institution or an open question. Reader-facing fields exist twice, English and Thai; a record with no Thai says so rather than machine-translating in silence. Every claim carries its tier and, where the tier is `cited`, the id of a source in data/sources/sources.json.",
 "type": "object",
 "required": [
  "schema",
  "id",
  "type",
  "names",
  "region",
  "text",
  "sources",
  "provenance",
  "confidence",
  "updated"
 ],
 "additionalProperties": false,
 "patternProperties": {
  "^x_": {}
 },
 "properties": {
  "schema": {
   "type": "integer",
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "type": {
   "type": "string",
   "enum": [
    "tradition",
    "method",
    "tool",
    "ink",
    "motif",
    "rite",
    "person",
    "place",
    "term",
    "story",
    "find",
    "art",
    "org",
    "issue"
   ]
  },
  "names": {
   "type": "object",
   "required": [
    "name"
   ],
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "description": "the term as the tradition uses it"
    },
    "aliases": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "said": {
     "type": "string",
     "description": "how it is said or spelled locally, when that differs from the written name"
    },
    "sort": {
     "type": "string",
     "description": "sort key when the name starts with an article or a first name"
    },
    "th": {
     "type": "string",
     "description": "The name in Thai script."
    },
    "shan": {
     "type": "string",
     "description": "The name in Shan, where the place has one."
    },
    "rtgs": {
     "type": "string",
     "description": "Royal Thai General System transcription."
    },
    "said_th": {
     "type": "string",
     "description": "names.said, in Thai."
    },
    "my": {
     "type": "string",
     "description": "the name in Burmese script"
    },
    "local": {
     "type": "string",
     "description": "the name in the language of the people whose tradition it is, in their own script"
    },
    "local_lang": {
     "type": "string"
    }
   }
  },
  "etymology": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "root": {
     "type": "string",
     "description": "the etymon or morpheme split, e.g. Taino barbacoa > Spanish barbacoa > English barbecue"
    },
    "first_attested": {
     "type": "string",
     "description": "earliest dated use you can NAME with a source; blank if none"
    },
    "note": {
     "type": "string"
    },
    "tier": {
     "$ref": "#/$defs/tier"
    },
    "source": {
     "type": "string"
    }
   }
  },
  "region": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   },
   "description": "open list, validated against data/vocab/regions.json with a warning"
  },
  "facets": {
   "type": "object",
   "description": "open per-type facets; values are scalars or lists of scalars. Known keys per type are listed in data/vocab/facets.json",
   "additionalProperties": {
    "type": [
     "string",
     "number",
     "boolean",
     "null",
     "array"
    ],
    "items": {
     "type": [
      "string",
      "number"
     ]
    }
   }
  },
  "text": {
   "type": "object",
   "required": [
    "what"
   ],
   "additionalProperties": false,
   "properties": {
    "what": {
     "type": "string",
     "minLength": 1,
     "description": "one plain paragraph: what it is"
    },
    "story": {
     "type": "string",
     "description": "the narrative, told as narrative; source marks inline: *Tradition —* / *Inference —*"
    },
    "how": {
     "type": "string",
     "description": "how it is made, served, eaten, or done"
    },
    "today": {
     "type": "string",
     "description": "present-tense state, dated where possible"
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "kin": {
   "type": "array",
   "description": "what other nodes ARE to this one, said from here. Directional: the other record says its own sentence back.",
   "items": {
    "type": "object",
    "required": [
     "to",
     "as"
    ],
    "additionalProperties": false,
    "properties": {
     "to": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
     },
     "as": {
      "type": "string",
      "minLength": 1
     },
     "rel": {
      "type": "string",
      "enum": [
       "tradition",
       "method",
       "tool",
       "ink",
       "motif",
       "rite",
       "person",
       "place",
       "term",
       "story",
       "find",
       "art",
       "org",
       "issue",
       "finding",
       "part",
       "whole",
       "origin",
       "descendant",
       "contrast",
       "same-word",
       "kin",
       "source",
       "teacher",
       "student"
      ],
      "description": "What the target IS to this record. Normally the target's own type; the relational values (part, whole, origin, descendant, contrast, same-word) are for edges the type alone does not describe."
     }
    }
   }
  },
  "confusable_with": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "tell"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "tell": {
      "type": "string"
     }
    }
   }
  },
  "geo": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "lat",
    "lon"
   ],
   "properties": {
    "lat": {
     "type": "number"
    },
    "lon": {
     "type": "number"
    },
    "precision": {
     "type": "string",
     "enum": [
      "exact",
      "building",
      "street",
      "village",
      "town",
      "city",
      "county",
      "region"
     ]
    },
    "source": {
     "type": "string"
    },
    "elevation_m": {
     "type": [
      "number",
      "null"
     ],
     "description": "metres above sea level, where known"
    }
   }
  },
  "address": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "street": {
     "type": "string"
    },
    "city": {
     "type": "string"
    },
    "county": {
     "type": "string"
    },
    "state": {
     "type": "string",
     "enum": [
      "AL",
      "AK",
      "AZ",
      "AR",
      "CA",
      "CO",
      "CT",
      "DE",
      "DC",
      "FL",
      "GA",
      "HI",
      "ID",
      "IL",
      "IN",
      "IA",
      "KS",
      "KY",
      "LA",
      "ME",
      "MD",
      "MA",
      "MI",
      "MN",
      "MS",
      "MO",
      "MT",
      "NE",
      "NV",
      "NH",
      "NJ",
      "NM",
      "NY",
      "NC",
      "ND",
      "OH",
      "OK",
      "OR",
      "PA",
      "PR",
      "RI",
      "SC",
      "SD",
      "TN",
      "TX",
      "UT",
      "VT",
      "VA",
      "WA",
      "WV",
      "WI",
      "WY"
     ]
    },
    "postcode": {
     "type": "string"
    }
   }
  },
  "links": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "label",
     "url"
    ],
    "additionalProperties": false,
    "properties": {
     "label": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^s:"
   },
   "description": "ids from data/sources/sources.json only"
  },
  "provenance": {
   "type": "object",
   "required": [
    "default"
   ],
   "additionalProperties": false,
   "properties": {
    "default": {
     "$ref": "#/$defs/prov"
    },
    "fields": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/prov"
     },
     "description": "dotted field path -> provenance override, e.g. text.story"
    }
   }
  },
  "images": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "file",
     "source",
     "license"
    ],
    "additionalProperties": false,
    "properties": {
     "file": {
      "type": "string",
      "description": "path relative to data/images/"
     },
     "source": {
      "type": "string",
      "enum": [
       "commons",
       "own",
       "contributed",
       "flickr",
       "loc",
       "diagram",
       "other"
      ]
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "page_url": {
      "type": "string"
     },
     "license": {
      "type": "string"
     },
     "license_url": {
      "type": "string"
     },
     "author": {
      "type": "string"
     },
     "credit": {
      "type": "string"
     },
     "alt": {
      "type": "string"
     },
     "date": {
      "type": "string"
     },
     "primary": {
      "type": "boolean"
     },
     "sha256": {
      "type": "string"
     },
     "width": {
      "type": "integer"
     },
     "height": {
      "type": "integer"
     }
    }
   }
  },
  "confidence": {
   "type": "string",
   "enum": [
    "high",
    "medium",
    "low"
   ]
  },
  "needs_verification": {
   "type": "boolean"
  },
  "updated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "tags": {
   "type": "array",
   "description": "Free tags from data/vocab/tags.json, for grouping pages a reader might arrive at sideways. A tag here makes no claim about evidence; the provenance block does that.",
   "items": {
    "type": "string"
   }
  },
  "sections": {
   "type": "array",
   "description": "Long-form pieces (type story, art): headed sections rendered in order after text.what",
   "items": {
    "type": "object",
    "required": [
     "h",
     "text"
    ],
    "additionalProperties": false,
    "properties": {
     "h": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "images": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "description": "indices into images[] to show beside this section"
     }
    }
   }
  },
  "text_th": {
   "type": "object",
   "additionalProperties": false,
   "description": "The Thai text. Same keys as `text`. A key present here is published on the /th/ page; a key absent leaves that section showing the English with a note saying it has not been written in Thai yet. Never machine-translated without saying so in provenance.",
   "properties": {
    "what": {
     "type": "string"
    },
    "story": {
     "type": "string"
    },
    "how": {
     "type": "string"
    },
    "today": {
     "type": "string"
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "offer": {
   "type": "object",
   "additionalProperties": false,
   "description": "A paid thing attached to this record. Empty on every record until the site's owner sets one. `kind` says what was paid for; the page prints that word to the reader.",
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "sponsor",
      "listing",
      "affiliate",
      "own-product"
     ]
    },
    "who": {
     "type": "string"
    },
    "url": {
     "type": "string"
    },
    "price_thb": {
     "type": "number"
    },
    "note": {
     "type": "string"
    },
    "since": {
     "type": "string"
    }
   }
  },
  "x_commons_files": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Candidate Wikimedia Commons File: titles, to be fetched with their licences by tools/harvest_commons.py. Not published as-is."
  },
  "practice": {
   "type": "object",
   "additionalProperties": false,
   "description": "For a tradition: the fields every chart on this site is computed from. A field left out is left out of the chart, and the chart says how many records it had.",
   "properties": {
    "method": {
     "type": "string",
     "enum": [
      "poke",
      "tap",
      "stitch",
      "cut",
      "rub",
      "machine",
      "mixed"
     ],
     "description": "how the pigment gets under the skin: a hand-held point pushed in (poke), a hafted comb struck by a mallet (tap), a threaded needle drawn through (stitch), an incision rubbed with pigment (cut), pigment rubbed into an abrasion (rub), or a machine"
    },
    "tool": {
     "type": "string",
     "description": "the record id of the instrument, where this site has one"
    },
    "ink": {
     "type": "string",
     "description": "the record id of the pigment"
    },
    "placement": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "face",
       "chin",
       "neck",
       "chest",
       "back",
       "belly",
       "arms",
       "hands",
       "fingers",
       "thighs",
       "legs",
       "knees",
       "feet",
       "waist-to-knee",
       "waist-to-ankle",
       "whole-body",
       "buttocks",
       "mouth",
       "forehead",
       "tongue"
      ]
     }
    },
    "marked": {
     "type": "string",
     "enum": [
      "men",
      "women",
      "both",
      "initiates",
      "few"
     ],
     "description": "whose skin carries it"
    },
    "marks": {
     "type": "string",
     "enum": [
      "men",
      "women",
      "either",
      "specialist",
      "kin"
     ],
     "description": "who does the work"
    },
    "status": {
     "type": "string",
     "enum": [
      "living",
      "revived",
      "thinning",
      "dormant",
      "historical"
     ]
    },
    "countries": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "ISO 3166-1 alpha-2, for the map"
    },
    "first_record": {
     "type": "integer",
     "description": "year of the earliest record this site can name; negative is BCE"
    },
    "first_record_note": {
     "type": "string",
     "description": ""
    },
    "break": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 2,
     "maxItems": 2,
     "description": "[from, to] — the years between the last ordinary practice and the revival, where both are datable"
    },
    "revived": {
     "type": "integer"
    },
    "suppressed_by": {
     "type": "string",
     "description": "who stopped it, and under what instrument"
    },
    "sessions": {
     "type": "string",
     "description": "how long the work takes, as the tradition itself puts it"
    },
    "note": {
     "type": "string",
     "description": ""
    }
   }
  },
  "when": {
   "type": "object",
   "additionalProperties": false,
   "description": "A record's place on the timeline. Years are integers; negative is BCE. `circa` marks a date the source itself hedges.",
   "properties": {
    "from": {
     "type": "integer"
    },
    "to": {
     "type": "integer"
    },
    "circa": {
     "type": "boolean"
    },
    "label": {
     "type": "string",
     "description": ""
    },
    "label_th": {
     "type": "string",
     "description": ""
    }
   }
  },
  "instrument": {
   "type": "object",
   "additionalProperties": false,
   "description": "For a tool: what it is made of and how it is worked.",
   "properties": {
    "material": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "length_cm": {
     "type": "number"
    },
    "length_note": {
     "type": "string",
     "description": ""
    },
    "points": {
     "type": "string",
     "description": "how many points meet the skin, and in what arrangement"
    },
    "worked": {
     "type": "string",
     "enum": [
      "pushed",
      "tapped",
      "struck",
      "drawn",
      "dragged"
     ]
    },
    "hands": {
     "type": "integer",
     "description": "how many hands the work takes, the subject's held taut by others not counted"
    },
    "held_by": {
     "type": "string",
     "description": ""
    },
    "museum": {
     "type": "string",
     "description": "a holding institution and accession number, where one is named"
    }
   }
  },
  "mark": {
   "type": "object",
   "additionalProperties": false,
   "description": "For a motif: what it is for, where it goes, and whether it has to be earned.",
   "properties": {
    "does": {
     "type": "string",
     "description": ""
    },
    "does_th": {
     "type": "string",
     "description": ""
    },
    "where": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "earned": {
     "type": "boolean"
    },
    "earned_how": {
     "type": "string",
     "description": ""
    },
    "figure": {
     "type": "string",
     "description": ""
    }
   }
  }
 },
 "$defs": {
  "tier": {
   "type": "string",
   "enum": [
    "cited",
    "harvested",
    "tradition",
    "inference",
    "field"
   ]
  },
  "prov": {
   "type": "object",
   "required": [
    "tier"
   ],
   "additionalProperties": false,
   "properties": {
    "tier": {
     "$ref": "#/$defs/tier"
    },
    "source": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "fetched_at": {
     "type": "string"
    }
   }
  }
 }
}
